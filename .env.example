# Copy with scripts/setup.py, then edit .local/app/.env privately.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=

# Keep the existing default, or select a model your OpenAI account can access.
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=

# First test: no real products, wallet, or purchases.
RESTOCK_MODE=rehearsal
RESTOCK_MAX_BUDGET_CENTS=10000
RESTOCK_APPROVAL_WAIT_SECONDS=120
RESTOCK_ZINC_CONNECTION=restock-zinc
RESTOCK_OFFICE_CONNECTION=restock-office
LINK_SESSION_CONNECTION=link-session
LINK_SESSION_BACKEND=connection

# Native sandbox proxy. Configure after the first rehearsal deploy (or local tunnel).
# scripts/configure_proxy.py saves the URL and creates the private signing key.
RESTOCK_LINK_TRANSPORT=proxy
RESTOCK_PROXY_URL=
RESTOCK_PROXY_SIGNING_KEY=

# Paste your Zinc search API key here, then create the restock-zinc Connection.
ZINC_API_KEY=

# Optional automatic Slack updates; use scripts/configure_updates.py.
RESTOCK_PUBLIC_URL=
RESTOCK_UPDATES_SIGNING_KEY=
